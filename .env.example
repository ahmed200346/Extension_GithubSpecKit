# Database Configuration — PostgreSQL
DATABASE_URL=postgresql://user:password@localhost:5432/dbname

# LLM Provider — Strategy via backend/app/core/llm_client.py
# Valeurs possibles : ollama | gemini | nvidia
LLM_PROVIDER=gemini

# Ollama Configuration (si LLM_PROVIDER=ollama)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=gemma4:31b-cloud

# Gemini Configuration (si LLM_PROVIDER=gemini)
GEMINI_API_KEY=VOTRE_CLE_GEMINI_ICI
GEMINI_MODEL=gemini-3.1-flash-lite

# NVIDIA Configuration (si LLM_PROVIDER=nvidia)
NVIDIA_API_KEY=VOTRE_CLE_NVIDIA_ICI
NVIDIA_MODEL=meta/llama-3.3-70b-instruct
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1

# Application Configuration
PDF_STORAGE_DIR=./storage/pdfs
LOG_LEVEL=INFO

# Target Project — LAISSEZ VIDE pour auto-découverte (recommandé)
# Le TicketManager résout dynamiquement : TARGET_PROJECT_PATH > scan **/.task_runtime/current-task.json > scan specs/*/tasks.md
TARGET_PROJECT_PATH=

# Ticket Agent
ENABLE_AUDITOR=True
AUDITOR_THRESHOLD=75.0
LLM_REQUEST_TIMEOUT=600
