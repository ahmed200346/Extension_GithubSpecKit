{
  "name": "agentdocx-speckit",
  "displayName": "AgentDocx SpecKit",
  "description": "Extension VS Code pour le suivi et le déclenchement du pipeline de documentation Spec Kit",
  "version": "0.0.2",
  "publisher": "agentdocx",
  "repository": {
    "type": "git",
    "url": "https://github.com/ahmed200346/Extension_GithubSpecKit.git"
  },
  "engines": {
    "vscode": "^1.125.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "agentdocx-speckit.start_server",
        "title": "AgentDocx SpecKit: Démarrer le Serveur FastAPI"
      },
      {
        "command": "agentdocx-speckit.stopServer",
        "title": "AgentDocx SpecKit: Arrêter le Serveur FastAPI"
      },
      {
        "command": "agentdocx-speckit.startWatcher",
        "title": "AgentDocx SpecKit: Démarrer le Watcher Python"
      },
      {
        "command": "agentdocx-speckit.stopWatcher",
        "title": "AgentDocx SpecKit: Arrêter le Watcher Python"
      },
      {
        "command": "agentdocx-speckit.triggerPipeline",
        "title": "AgentDocx SpecKit: Déclencher la régénération"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "npm run check-types && npm run lint && node esbuild.js",
    "watch": "npm-run-all -p watch:*",
    "watch:esbuild": "node esbuild.js --watch",
    "watch:tsc": "tsc --noEmit --watch",
    "package": "npm run check-types && npm run lint && node esbuild.js --production",
    "compile-tests": "tsc -p . --outDir out",
    "watch-tests": "tsc -p . --watch --outDir out",
    "pretest": "npm run compile-tests && npm run compile && npm run lint",
    "check-types": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/node": "^20.x",
    "@types/vscode": "^1.125.0",
    "@typescript-eslint/eslint-plugin": "^8.26.0",
    "@typescript-eslint/parser": "^8.26.0",
    "@vscode/test-cli": "^0.0.10",
    "@vscode/test-electron": "^2.4.1",
    "esbuild": "^0.25.0",
    "eslint": "^9.21.0",
    "npm-run-all": "^4.1.5",
    "typescript": "^5.7.3"
  }
}